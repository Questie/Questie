<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- Visual assets only. Never inherit Blizzard's StaticPopup behavior. -->
  <Button name="AddonDialogButtonTemplate" registerForClicks="LeftButtonUp" virtual="true">
    <Size x="120" y="21"/>
    <ButtonText parentKey="Text">
      <Anchors><Anchor point="CENTER" y="1"/></Anchors>
    </ButtonText>
    <NormalTexture file="Interface\Buttons\UI-DialogBox-Button-Up">
      <TexCoords left="0" right="1" top="0" bottom="0.71875"/>
    </NormalTexture>
    <PushedTexture file="Interface\Buttons\UI-DialogBox-Button-Down">
      <TexCoords left="0" right="1" top="0" bottom="0.71875"/>
    </PushedTexture>
    <DisabledTexture file="Interface\Buttons\UI-DialogBox-Button-Disabled">
      <TexCoords left="0" right="1" top="0" bottom="0.71875"/>
    </DisabledTexture>
    <HighlightTexture file="Interface\Buttons\UI-DialogBox-Button-Highlight" alphaMode="ADD">
      <TexCoords left="0" right="1" top="0" bottom="0.71875"/>
    </HighlightTexture>
    <NormalFont style="GameFontNormal"/>
    <DisabledFont style="GameFontDisable"/>
    <HighlightFont style="GameFontHighlight"/>
  </Button>

  <Frame name="AddonDialogTemplate" inherits="BackdropTemplate" mixin="AddonDialogMixin" virtual="true"
      hidden="true" toplevel="true" frameStrata="DIALOG" enableMouse="true" enableKeyboard="true" clampedToScreen="true">
    <Size x="420" y="136"/>
    <Anchors><Anchor point="TOP" y="-135"/></Anchors>
    <Layers>
      <Layer level="BACKGROUND" textureSubLevel="-7">
        <Texture parentKey="Background" hidden="true">
          <Anchors>
            <Anchor point="TOPLEFT" x="7" y="-7"/>
            <Anchor point="BOTTOMRIGHT" x="-7" y="7"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="BACKGROUND" textureSubLevel="-4">
        <Texture parentKey="Border" setAllPoints="true" hidden="true"/>
      </Layer>
      <Layer level="ARTWORK">
        <Texture parentKey="AlertIcon" file="Interface\DialogFrame\UI-Dialog-Icon-AlertNew">
          <Size x="36" y="36"/>
          <Anchors><Anchor point="LEFT" x="24"/></Anchors>
        </Texture>
        <FontString name="$parentText" parentKey="Text" inherits="GameFontHighlight" justifyH="CENTER">
          <Size x="290" y="0"/>
          <Anchors><Anchor point="TOP" y="-16"/></Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentButton1" parentKey="Button1" inherits="AddonDialogButtonTemplate"/>
      <Button name="$parentButton2" parentKey="Button2" inherits="AddonDialogButtonTemplate"/>
      <EditBox name="$parentEditBox" parentKey="EditBox" autoFocus="false" hidden="true">
        <Size x="280" y="28"/>
        <Layers><Layer level="BACKGROUND">
          <Texture setAllPoints="true"><Color r="0" g="0" b="0" a="0.8"/></Texture>
        </Layer></Layers>
        <FontString inherits="GameFontHighlight"/>
        <TextInsets left="6" right="6" top="2" bottom="2"/>
      </EditBox>
    </Frames>
    <Scripts>
      <OnLoad method="OnLoad" inherit="append"/>
      <OnHide method="OnHide"/>
      <OnKeyDown method="OnKeyDown"/>
    </Scripts>
  </Frame>
</Ui>
